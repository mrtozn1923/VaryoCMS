@model ContentItemFormViewModel
@{
    var languages = Model.AvailableLanguages.Count > 0
        ? Model.AvailableLanguages.Select(l => (Code: l.Code, Name: l.Name)).ToList()
        : new List<(string Code, string Name)> { (Model.PrimaryLanguageCode, Model.PrimaryLanguageCode.ToUpper()) };
    var sharedFields = Model.Fields.Where(f => !f.IsLocalized).ToList();
    var localizedFields = Model.Fields.Where(f => f.IsLocalized).ToList();
}

@if (TempData["Error"] is string err)
{
    <div class="cms-alert-danger mb-3"><i class="bi bi-exclamation-triangle-fill"></i><span>@err</span></div>
}

<div class="cms-alert-info mb-3">
    <i class="bi bi-info-circle-fill"></i>
    <span>@L["ContentItem.PublishHint"]</span>
</div>

<input type="hidden" asp-for="PrimaryLanguageCode" />

@* Shared fields: Status/Slug + any is_localized=false content field — same regardless of which
   language tab is active, rendered exactly once. *@
<div class="row">
    <div class="col-md-6 cms-form-group">
        <label asp-for="Status" class="cms-label">@L["Common.Status"]</label>
        <select asp-for="Status" class="form-select">
            <option value="draft">@L["Status.Draft"]</option>
            <option value="published">@L["Status.Published"]</option>
            <option value="archived">@L["Status.Archived"]</option>
        </select>
        <small class="cms-hint">@L["ContentItem.Status.Hint"]</small>
    </div>
    <div class="col-md-6 cms-form-group">
        <label asp-for="Slug" class="cms-label">@L["Common.Slug"]</label>
        <input asp-for="Slug" class="form-control slug-field" placeholder="@L["ContentItem.SlugPlaceholder"]" />
    </div>
</div>

@foreach (var field in sharedFields)
{
    <partial name="_FieldInput" model="field" />
}

<hr class="cms-divider" />

@* Language tabs — client-side only (content-item-tabs.js): switching never reloads the page, so
   unsaved input in the outgoing language is never lost. Hidden when there's only one language. *@
@if (languages.Count > 1)
{
    <div class="cms-tabs mb-3">
        @foreach (var lng in languages)
        {
            <button type="button" class="cms-tab @(lng.Code == Model.PrimaryLanguageCode ? "active" : "")"
                    title="@lng.Name" data-lang-tab="@lng.Code">@lng.Code.ToUpper()</button>
        }
    </div>
}

@foreach (var lng in languages)
{
    var isPrimary = lng.Code == Model.PrimaryLanguageCode;
    <div data-lang-panel="@lng.Code" class="@(isPrimary ? "" : "d-none")">
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="form-check mb-0">
                <input type="checkbox" class="form-check-input" id="langActive_@lng.Code"
                       name="LanguageActive[@lng.Code]" value="true"
                       @(Model.LanguageActive.GetValueOrDefault(lng.Code) ? "checked" : null) />
                <label class="form-check-label fw-medium" for="langActive_@lng.Code">@L["ContentItem.LangActive"]</label>
            </div>
        </div>
        <small class="d-block text-muted mb-3" style="font-size:.8em">@L["ContentItem.LangActive.Hint"]</small>

        <div class="cms-form-group">
            <label for="title_@lng.Code" class="cms-label">@L["ContentItem.Title"] <span class="text-danger">*</span></label>
            <input id="title_@lng.Code" name="Titles[@lng.Code]"
                   class="form-control @(isPrimary ? "title-source" : "")" autocomplete="off"
                   value="@Model.Titles.GetValueOrDefault(lng.Code)"
                   placeholder="@L["ContentItem.TitlePlaceholder"]" />
        </div>

        @if (localizedFields.Count == 0 && sharedFields.Count == 0)
        {
            <div class="cms-alert-info"><i class="bi bi-info-circle-fill"></i><span>@L["ContentItem.NoFields"]</span></div>
        }
        else
        {
            foreach (var field in localizedFields)
            {
                <partial name="_FieldInput" model="field" view-data="@(new ViewDataDictionary(ViewData) { ["Lang"] = lng.Code })" />
            }
        }
    </div>
}
