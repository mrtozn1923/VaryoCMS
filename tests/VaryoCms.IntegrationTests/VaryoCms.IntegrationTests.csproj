<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.16" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="3.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schema + system bootstrap + demo dev-tenant seed. As of v1.5.0 this is the full
         migration chain (formerly 001/002/005/006 — the schema-affecting parts of 005/006
         are now baked into 001_v1_schema.sql). Tenant-specific content
         (db/tenant-seeds/*.sql) is intentionally excluded — it targets a real
         production tenant, not test fixtures. -->
    <Content Include="..\..\db\migrations\001_v1_schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>migrations\001_v1_schema.sql</Link>
    </Content>
    <Content Include="..\..\db\migrations\002_v1_system_seed.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>migrations\002_v1_system_seed.sql</Link>
    </Content>
    <Content Include="..\..\db\migrations\003_v1_demo_seed.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>migrations\003_v1_demo_seed.sql</Link>
    </Content>
    <Content Include="..\..\db\migrations\004_public_api_list_index.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>migrations\004_public_api_list_index.sql</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VaryoCms.Domain\VaryoCms.Domain.csproj" />
    <ProjectReference Include="..\..\src\VaryoCms.Application\VaryoCms.Application.csproj" />
    <ProjectReference Include="..\..\src\VaryoCms.Infrastructure\VaryoCms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\VaryoCms.Web\VaryoCms.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
