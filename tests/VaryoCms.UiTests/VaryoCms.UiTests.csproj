<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.16" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.51.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="3.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy schema + base seed + additive platform migrations. Tenant-specific dev seeds like
         003/004 (which wipe/target dev data) are excluded; but additive schema migrations (005:
         is_read / notify_on_create columns) MUST be included or repository queries fail. -->
    <Content Include="..\..\db\migrations\001_v1_schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>migrations\001_v1_schema.sql</Link>
    </Content>
    <Content Include="..\..\db\migrations\002_v1_dev_seed.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>migrations\002_v1_dev_seed.sql</Link>
    </Content>
    <Content Include="..\..\db\migrations\005_inbox_and_notify.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>migrations\005_inbox_and_notify.sql</Link>
    </Content>
    <Content Include="..\..\db\migrations\006_widen_login_code_hash.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>migrations\006_widen_login_code_hash.sql</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaryoCms.IntegrationTests\VaryoCms.IntegrationTests.csproj" />
    <ProjectReference Include="..\..\src\VaryoCms.Web\VaryoCms.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
